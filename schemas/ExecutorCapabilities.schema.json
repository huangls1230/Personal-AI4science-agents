{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ExecutorCapabilities",
  "$ref": "#/$defs/ExecutorCapabilities",
  "$defs": {
    "ArtifactReference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256",
        "schema_version"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "schema_version": {
          "const": "1.0"
        }
      }
    },
    "EvidenceReference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifact",
        "description",
        "schema_version"
      ],
      "properties": {
        "artifact": {
          "$ref": "#/$defs/ArtifactReference"
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "locator": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            {
              "type": "null"
            }
          ]
        },
        "schema_version": {
          "const": "1.0"
        }
      }
    },
    "UsageMetrics": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version"
      ],
      "properties": {
        "input_tokens": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "output_tokens": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "token_measurement": {
          "enum": [
            "unknown",
            "exact",
            "estimated"
          ]
        },
        "cost": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "currency": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            {
              "type": "null"
            }
          ]
        },
        "model_calls": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "input_bytes": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "output_bytes": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "schema_version": {
          "const": "1.0"
        }
      }
    },
    "ExecutorCapabilities": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "executor",
        "schema_version"
      ],
      "properties": {
        "executor": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "capabilities": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          }
        },
        "available": {
          "type": "boolean"
        },
        "implemented": {
          "type": "boolean"
        },
        "allowed_sensitivities": {
          "type": "array",
          "items": {
            "enum": [
              "public",
              "internal",
              "sensitive"
            ]
          }
        },
        "compatible_models": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          }
        },
        "schema_version": {
          "const": "1.0"
        }
      }
    },
    "ResearchTask": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "task_id",
        "objective",
        "task_type",
        "schema_version"
      ],
      "properties": {
        "task_id": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "objective": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "task_type": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "required_capabilities": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          }
        },
        "complexity": {
          "enum": [
            "deterministic",
            "simple",
            "complex"
          ]
        },
        "sensitivity": {
          "enum": [
            "public",
            "internal",
            "sensitive"
          ]
        },
        "executor": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            {
              "type": "null"
            }
          ]
        },
        "input_artifacts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ArtifactReference"
          }
        },
        "output_artifacts": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          }
        },
        "status": {
          "enum": [
            "pending",
            "running",
            "completed",
            "failed",
            "blocked",
            "approval_required"
          ]
        },
        "idempotency_key": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            {
              "type": "null"
            }
          ]
        },
        "schema_version": {
          "const": "1.0"
        }
      }
    },
    "ExecutionRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "task",
        "executor",
        "schema_version"
      ],
      "properties": {
        "task": {
          "$ref": "#/$defs/ResearchTask"
        },
        "executor": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "model": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            {
              "type": "null"
            }
          ]
        },
        "attempt": {
          "type": "integer",
          "minimum": 1
        },
        "schema_version": {
          "const": "1.0"
        }
      }
    },
    "ExecutionResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "task_id",
        "executor",
        "status",
        "schema_version"
      ],
      "properties": {
        "task_id": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "executor": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "status": {
          "enum": [
            "completed",
            "failed",
            "blocked",
            "approval_required"
          ]
        },
        "summary": {
          "type": "string"
        },
        "output_artifacts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ArtifactReference"
          }
        },
        "evidence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/EvidenceReference"
          }
        },
        "errors": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          }
        },
        "usage_metrics": {
          "$ref": "#/$defs/UsageMetrics"
        },
        "quality_status": {
          "enum": [
            "not_reviewed",
            "passed",
            "failed"
          ]
        },
        "approval_status": {
          "enum": [
            "not_required",
            "pending",
            "approved",
            "rejected"
          ]
        },
        "schema_version": {
          "const": "1.0"
        }
      }
    }
  }
}
